# Required: Telegram gateway
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric IDs. Private chats are positive; groups are usually negative.
TELEGRAM_BOT_ALLOWED_CHATS=

# Required: encrypted per-user connections
# Generate with: openssl rand -hex 32
CONNECTIONS_KEY=
# Optional public OAuth callback. Leave unset to use paste-back authentication.
# When set, forward this URL to http://127.0.0.1:8976 and register it with each provider.
CONNECTIONS_CALLBACK_URL=

# Required: GitHub connector
# Register the callback above, or http://127.0.0.1:8976/oauth/callback when using paste-back.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Required: Gmail and Google Calendar connectors
# Create a Web application OAuth client and register the same callback URL.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Required: AgentMail plugin
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
# Comma-separated full addresses or domain suffixes such as @example.com.
AGENTMAIL_ALLOWLIST=

# Optional: session tools
# pi-searxng defaults to http://localhost:8080.
SEARXNG_URL=
# Forwarded to the sandbox for the gh CLI. It is separate from /connect github.
GH_TOKEN=
