{
  "name": "picco",
  "version": "0.1.0",
  "private": true,
  "description": "Modular personal assistant framework",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "scripts": {
    "start": "pnpm --dir example/personal-assistant start",
    "dev": "pnpm --dir example/personal-assistant dev",
    "build": "pnpm --recursive --if-present build",
    "test": "vitest run --exclude 'integration/**'",
    "test:integration": "vitest run integration/",
    "test:smoke": "tsx ./scripts/smoke/real-model.ts",
    "test:smoke:extensions": "tsx ./scripts/smoke/extensions/run.ts",
    "test:smoke:all": "pnpm test:smoke && pnpm test:smoke:extensions",
    "typecheck": "tsc --noEmit",
    "fmt": "oxfmt packages/ example/ scripts/ integration/ docs/ .agents/skills/",
    "fmt:check": "oxfmt --check packages/ example/ scripts/ integration/ docs/ .agents/skills/",
    "lint": "oxlint packages/ example/ scripts/ integration/ docs/",
    "lint:fix": "oxlint --fix packages/ example/ scripts/ integration/ docs/",
    "validate": "pnpm build && pnpm fmt:check && pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration",
    "validate:fix": "pnpm fmt && pnpm lint:fix",
    "start:github": "tsx example/github-bot/src/index.ts",
    "start:hosted": "tsx example/hosted-assistant/src/index.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "publish": "changeset publish"
  },
  "dependencies": {
    "@picco-agent/core": "workspace:*",
    "@picco-agent/runtime-bwrap": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@changesets/cli": "^2.29.0",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
