{
  "name": "@picco-agent/headless-subagents",
  "version": "0.1.0",
  "description": "Headless Pi subagents with bounded delegation and persistent session traces.",
  "keywords": [
    "headless",
    "pi-extension",
    "pi-package",
    "subagents"
  ],
  "homepage": "https://github.com/anthonyshort/picco/tree/main/packages/headless-subagents",
  "bugs": {
    "url": "https://github.com/anthonyshort/picco/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/anthonyshort/picco.git",
    "directory": "packages/headless-subagents"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && esbuild ./src/index.ts --bundle --outfile=./dist/index.js --platform=node --format=esm --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-ai --external:@earendil-works/pi-ai/* --external:@earendil-works/pi-agent-core --external:typebox",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "typebox": "^1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  }
}
